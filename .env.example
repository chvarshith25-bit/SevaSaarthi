# ==============================================================================
# Formly (Seva Saarthi) — Environment Configuration Template
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
# Your Supabase Project URL (found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase Anonymous Public Key (safe to expose in client)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Your Supabase Service Role Key (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# OCR & AI Document Extraction Configuration (Optional / Managed)
# ------------------------------------------------------------------------------
# OCR Provider Mode: 'builtin' | 'google-cloud-vision' | 'aws-textract' | 'tesseract'
OCR_PROVIDER=builtin
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=ap-south-1

# ------------------------------------------------------------------------------
# Live Portal Automation (Optional)
# ------------------------------------------------------------------------------
TARGET_PORTAL_URL=https://scholarships.gov.in
HEADLESS_MODE=false
