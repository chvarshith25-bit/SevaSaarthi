{
  "manifest_version": 3,
  "name": "SevaSaarthi — Citizen Application & Portal Autofill Assistant",
  "version": "1.2.0",
  "description": "Instant autofill and verification for government schemes, PAN card (Protean/NSDL), scholarships (NSP), and welfare portals.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SevaSaarthi Citizen Assistant"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.google.com/recaptcha/*",
        "*://*.recaptcha.net/*",
        "*://*.hcaptcha.com/*",
        "*://challenges.cloudflare.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "commands": {
    "autofill_page": {
      "suggested_key": {
        "default": "Alt+Shift+F",
        "mac": "Alt+Shift+F"
      },
      "description": "Autofill current page with SevaSaarthi"
    }
  }
}
